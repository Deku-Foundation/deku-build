{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deku-foundation.github.io/schemas/build-result-v1.schema.json",
  "title": "Deku Build Result v1",
  "description": "Typed build evidence metadata. Validation does not authenticate the result or inspect artifact bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build_id", "outcome", "source", "recipe", "builder", "target", "execution", "outputs", "tests", "attestation_status"],
  "properties": {
    "schema_version": { "const": 1 },
    "build_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "outcome": { "enum": ["success", "failed"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9+._-]{0,127}$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+:~_-]{0,127}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "toolchain"],
      "properties": {
        "image": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/:@-]{0,254}@sha256:[0-9a-f]{64}$" },
        "toolchain": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "abi"],
      "properties": {
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "abi": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_unix_seconds", "finished_unix_seconds", "isolation", "privilege", "network"],
      "properties": {
        "started_unix_seconds": { "type": "integer", "minimum": 1 },
        "finished_unix_seconds": { "type": "integer", "minimum": 1 },
        "isolation": { "const": "disposable-vm" },
        "privilege": { "const": "unprivileged" },
        "network": { "const": "disabled-during-build" }
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "maxLength": 200, "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "kind": { "enum": ["package", "archive", "file"] },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2199023255552 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome", "exit_code", "duration_millis"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
          "outcome": { "enum": ["passed", "failed", "skipped"] },
          "exit_code": { "type": ["integer", "null"] },
          "duration_millis": { "type": "integer", "minimum": 0, "maximum": 604800000 }
        }
      }
    },
    "attestation_status": { "const": "unsigned" }
  }
}